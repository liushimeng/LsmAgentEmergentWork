# Rust / Cargo
/target
**/*.rs.bk

# 构建产物
/laew
/laew.exe
/laew.old.exe

# 运行时数据
*.db
*.db-journal
*.db-wal
*.db-shm
# SQLite 损坏自愈的隔离备份(L1042)
*.corrupt-*.bak

# tmpPlan(临时计划,不入库)
tmpPlan/
plans/

# logs(AutoTestAndSaveReport 运行日志,不入库)
/logs/

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store

# testReport:保留报告与脚本,仅忽略大体量原始产物
testReport/
tests/

# DebugReport(laew -debug 调试报告,自动落盘,不入库)
DebugReport/

# 运行日志文件(--debug/--info 落工作目录 llaew_YYYYMMDD_HHMMSS.log,不入库)
/llaew_*.log

# CrashReport(全局 panic hook 崩溃取证,自动落盘,不入库)
CrashReport/

# AuditTrail(D9-8 决策审计 JSONL,自动落盘,不入库)
AuditTrail/

# TestWorkSpace(自动化测试目录,临时文件不入库;与 tmpPlan/ 类似的「一次性产物」)
TestWorkSpace/

# scripts(本地脚本目录;注意:mock_llm_server.py 为已跟踪文件,忽略规则仅对新增文件生效)
/scripts/


# laew 运行期配置文件(含 api_key,不入库)
/laew-config.json
